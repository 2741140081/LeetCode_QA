<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mangareader.mapper.MailSendRecordMapper">

    <resultMap id="MailSendRecordResultMap" type="com.mangareader.model.entity.MailSendRecord">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="to_email" property="toEmail" jdbcType="VARCHAR"/>
        <result column="subject" property="subject" jdbcType="VARCHAR"/>
        <result column="content" property="content" jdbcType="LONGVARCHAR"/>
        <result column="mail_type" property="mailType" jdbcType="TINYINT"/>
        <result column="send_status" property="sendStatus" jdbcType="TINYINT"/>
        <result column="retry_count" property="retryCount" jdbcType="INTEGER"/>
        <result column="error_msg" property="errorMsg" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mail_send_record (to_email, subject, content, mail_type, send_status)
        VALUES (#{toEmail}, #{subject}, #{content}, #{mailType}, #{sendStatus})
    </insert>

    <select id="selectPendingRecords" resultMap="MailSendRecordResultMap">
        SELECT * FROM mail_send_record
        WHERE send_status = 0
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

    <update id="updateStatus">
        UPDATE mail_send_record
        SET send_status = #{status},
            error_msg = #{errorMsg},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <update id="incrementRetryCount">
        UPDATE mail_send_record
        SET retry_count = retry_count + 1,
            updated_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>
