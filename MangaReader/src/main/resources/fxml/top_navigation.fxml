<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mangareader.controller.TopNavigationController"
      spacing="10" alignment="CENTER_LEFT" styleClass="top-navigation">

    <Label text="漫画阅读器" styleClass="app-title">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Region HBox.hgrow="ALWAYS"/>

    <Button fx:id="shelfButton" text="我的书架" onAction="#handleSwitchToShelf" styleClass="nav-button"/>
    <Button fx:id="downloadCenterButton" text="下载中心" onAction="#handleSwitchToDownloadCenter" styleClass="nav-button"/>
</HBox>