<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mangareader.mapper.MangaImageMapper">

    <!-- 结果映射 -->
    <resultMap id="MangaImageResultMap" type="com.mangareader.model.entity.MangaImage">
        <id column="image_id" property="imageId" jdbcType="BIGINT"/>
        <result column="chapter_id" property="chapterId" jdbcType="BIGINT"/>
        <result column="image_name" property="imageName" jdbcType="VARCHAR"/>
        <result column="image_type" property="imageType" jdbcType="VARCHAR"/>
        <result column="image_width" property="imageWidth" jdbcType="INTEGER"/>
        <result column="image_height" property="imageHeight" jdbcType="INTEGER"/>
        <result column="image_url" property="imageUrl" jdbcType="VARCHAR"/>
        <result column="download_url" property="downloadUrl" jdbcType="VARCHAR"/>
        <result column="download_status" property="downloadStatus" jdbcType="TINYINT"/>
        <result column="sort_order" property="sortOrder" jdbcType="INTEGER"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        image_id, chapter_id, image_name, image_type, image_width, image_height,
        image_url, download_url, download_status, sort_order, created_at
    </sql>

    <!-- 根据章节ID查询图片列表 -->
    <select id="findByChapterId" resultMap="MangaImageResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM manga_image
        WHERE chapter_id = #{chapterId}
        ORDER BY sort_order
    </select>

    <!-- 批量插入图片信息 -->
    <insert id="batchInsert" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="imageId">
        INSERT INTO manga_image (
        chapter_id, image_name, image_type, image_width, image_height,
        image_url, download_url, download_status, sort_order, created_at
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.chapterId}, #{item.imageName}, #{item.imageType}, #{item.imageWidth}, #{item.imageHeight},
            #{item.imageUrl}, #{item.downloadUrl}, #{item.downloadStatus}, #{item.sortOrder}, #{item.createdAt}
            )
        </foreach>
    </insert>
</mapper>
